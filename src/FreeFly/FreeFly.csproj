<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FreeFly</AssemblyName>
    <RootNamespace>FreeFly</RootNamespace>
    <Version>1.3.0</Version>
    <ThunderstoreAuthor>lllei</ThunderstoreAuthor>
    <ThunderstorePackageName>FreeFly</ThunderstorePackageName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\PeakGameDir.props" Condition="Exists('$(MSBuildProjectDirectory)\..\..\PeakGameDir.props')" />
  <PropertyGroup>
    <PeakGameDir Condition="'$(PeakGameDir)' == ''">$(PEAK_GAME_DIR)</PeakGameDir>
    <ManagedDir>$(PeakGameDir)\PEAK_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(PeakGameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="PhotonUnityNetworking" HintPath="$(ManagedDir)\PhotonUnityNetworking.dll" Private="false" />
    <Reference Include="PhotonRealtime" HintPath="$(ManagedDir)\PhotonRealtime.dll" Private="false" />
    <Reference Include="Zorro.Core.Runtime" HintPath="$(ManagedDir)\Zorro.Core.Runtime.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidatePeakGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PeakGameDir)' == ''" Text="Set PEAK_GAME_DIR or copy PeakGameDir.props.example to PeakGameDir.props." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll was not found under $(ManagedDir)." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found under $(BepInExCoreDir)." />
  </Target>

  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_BuildInfoLine Include="// &lt;auto-generated /&gt;" />
      <_BuildInfoLine Include="namespace FreeFly { internal static class BuildInfo { internal const string Version = &quot;$(Version)&quot;%3B } }" />
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs" Lines="@(_BuildInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="Deploy" DependsOnTargets="Build">
    <PropertyGroup><DeployDir>$(PeakGameDir)\BepInEx\plugins\FreeFly</DeployDir></PropertyGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed FreeFly to $(DeployDir)" />
  </Target>

  <Target Name="PackageThunderstore" DependsOnTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\Package.ps1&quot; -Configuration &quot;$(Configuration)&quot; -Version &quot;$(Version)&quot; -Author &quot;$(ThunderstoreAuthor)&quot; -PackageName &quot;$(ThunderstorePackageName)&quot; -SkipBuild" />
  </Target>
</Project>
